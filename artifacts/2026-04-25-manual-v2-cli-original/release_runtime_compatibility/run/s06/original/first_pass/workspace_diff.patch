diff --git a/.github/workflows/publish-npm.yml b/.github/workflows/publish-npm.yml
index c259fec..81e9cd3 100644
--- a/.github/workflows/publish-npm.yml
+++ b/.github/workflows/publish-npm.yml
@@ -113,6 +113,34 @@ jobs:
             echo "::endgroup::"
           done
 
+      - name: Smoke test Linux npm package in node bookworm
+        shell: bash
+        run: |
+          set -euo pipefail
+          rm -rf build/npm-smoke
+          mkdir -p build/npm-smoke
+          npm pack --pack-destination build/npm-smoke --ignore-scripts --silent
+          npm pack build/npm-platform-packages/ai-wiki-toolkit-linux-x64 --pack-destination build/npm-smoke --ignore-scripts --silent
+          meta_tgz="$(find build/npm-smoke -maxdepth 1 -name 'ai-wiki-toolkit-*.tgz' ! -name 'ai-wiki-toolkit-linux-x64-*.tgz' -print -quit)"
+          linux_tgz="$(find build/npm-smoke -maxdepth 1 -name 'ai-wiki-toolkit-linux-x64-*.tgz' -print -quit)"
+          if [ -z "$meta_tgz" ] || [ -z "$linux_tgz" ]; then
+            echo "Missing npm smoke tarball." >&2
+            exit 1
+          fi
+          docker run --rm --platform linux/amd64 \
+            -v "$PWD:/workspace:ro" \
+            -e META_TGZ="/workspace/$meta_tgz" \
+            -e LINUX_TGZ="/workspace/$linux_tgz" \
+            node:24-bookworm \
+            bash -lc '
+              set -euo pipefail
+              prefix="$(mktemp -d)"
+              npm install -g --prefix "$prefix" --ignore-scripts --omit=optional "$META_TGZ"
+              root="$(npm root -g --prefix "$prefix")/ai-wiki-toolkit"
+              npm install --prefix "$root" --ignore-scripts --no-save "$LINUX_TGZ"
+              "$prefix/bin/aiwiki-toolkit" --version
+            '
+
       - name: Publish platform npm packages
         shell: bash
         env:
