diff --git a/scripts/smoke_npm_linux_install.py b/scripts/smoke_npm_linux_install.py
new file mode 100644
index 0000000..e10d6d1
--- /dev/null
+++ b/scripts/smoke_npm_linux_install.py
@@ -0,0 +1,166 @@
+"""Smoke test the staged Linux npm package inside a Debian Bookworm Node image."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+import shutil
+import subprocess
+import sys
+import tempfile
+
+from ai_wiki_toolkit.npm_smoke import (
+    DEFAULT_LINUX_SMOKE_IMAGE,
+    DEFAULT_LINUX_SMOKE_TARGET,
+    SMOKE_CONTAINER_DIR,
+    find_smoke_platform_package,
+    render_smoke_meta_package_json,
+)
+
+
+def _run(command: list[str], *, cwd: Path | None = None) -> subprocess.CompletedProcess[str]:
+    result = subprocess.run(
+        command,
+        cwd=cwd,
+        capture_output=True,
+        text=True,
+        check=False,
+    )
+    if result.stdout:
+        print(result.stdout, end="")
+    if result.stderr:
+        print(result.stderr, end="", file=sys.stderr)
+    if result.returncode != 0:
+        raise SystemExit(result.returncode)
+    return result
+
+
+def _pack(package_dir: Path, destination: Path) -> Path:
+    result = _run(
+        [
+            "npm",
+            "pack",
+            str(package_dir),
+            "--pack-destination",
+            str(destination),
+            "--ignore-scripts",
+        ]
+    )
+    for line in reversed(result.stdout.splitlines()):
+        name = line.strip()
+        candidate = destination / name
+        if name.endswith(".tgz") and candidate.exists():
+            return candidate
+    raise RuntimeError(f"npm pack did not report a tarball for {package_dir}")
+
+
+def _copy_meta_package(root: Path, destination: Path, package_json: str) -> None:
+    destination.mkdir(parents=True)
+    shutil.copytree(root / "npm", destination / "npm")
+    shutil.copy2(root / "LICENSE", destination / "LICENSE")
+    shutil.copy2(root / "README.md", destination / "README.md")
+    (destination / "package.json").write_text(package_json, encoding="utf-8")
+
+
+def smoke_linux_npm_install(
+    *,
+    version: str,
+    repository_root: Path,
+    platform_package_root: Path,
+    image: str,
+    node_target: str,
+) -> None:
+    normalized_version = version.removeprefix("v")
+    package = find_smoke_platform_package(node_target)
+    platform_package_dir = platform_package_root / package.package_name
+    if not platform_package_dir.exists():
+        raise FileNotFoundError(f"Missing staged platform package: {platform_package_dir}")
+
+    root_package_json = json.loads(
+        (repository_root / "package.json").read_text(encoding="utf-8")
+    )
+    if root_package_json["version"] != normalized_version:
+        raise ValueError(
+            "package.json version "
+            f"{root_package_json['version']} does not match {normalized_version}"
+        )
+
+    with tempfile.TemporaryDirectory(prefix="aiwiki-npm-smoke-") as smoke_dir:
+        smoke_root = Path(smoke_dir)
+        platform_tarball = _pack(platform_package_dir, smoke_root)
+        meta_dir = smoke_root / "meta"
+        meta_package_json = render_smoke_meta_package_json(
+            root_package_json=root_package_json,
+            package=package,
+            platform_tarball_path=f"{SMOKE_CONTAINER_DIR}/{platform_tarball.name}",
+        )
+        _copy_meta_package(repository_root, meta_dir, meta_package_json)
+        meta_tarball = _pack(meta_dir, smoke_root)
+
+        container_meta_tarball = f"{SMOKE_CONTAINER_DIR}/{meta_tarball.name}"
+        result = _run(
+            [
+                "docker",
+                "run",
+                "--rm",
+                "--platform",
+                "linux/amd64",
+                "-v",
+                f"{smoke_root}:{SMOKE_CONTAINER_DIR}:ro",
+                "-w",
+                SMOKE_CONTAINER_DIR,
+                image,
+                "bash",
+                "-lc",
+                'npm install -g "$1" && aiwiki-toolkit --version',
+                "bash",
+                container_meta_tarball,
+            ]
+        )
+
+    expected = f"ai-wiki-toolkit {normalized_version}"
+    if expected not in result.stdout:
+        raise RuntimeError(f"Expected smoke output to contain {expected!r}")
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(
+        description="Smoke test staged Linux npm packages in node:24-bookworm."
+    )
+    parser.add_argument("--version", required=True, help="Package version with or without v.")
+    parser.add_argument(
+        "--repository-root",
+        type=Path,
+        default=Path.cwd(),
+        help="Repository root containing the npm meta package.",
+    )
+    parser.add_argument(
+        "--platform-package-root",
+        type=Path,
+        default=Path("build/npm-platform-packages"),
+        help="Directory containing staged npm platform package folders.",
+    )
+    parser.add_argument(
+        "--image",
+        default=DEFAULT_LINUX_SMOKE_IMAGE,
+        help="Docker image used for the Linux runtime smoke test.",
+    )
+    parser.add_argument(
+        "--node-target",
+        default=DEFAULT_LINUX_SMOKE_TARGET,
+        help="npm platform target to smoke test.",
+    )
+    args = parser.parse_args()
+
+    smoke_linux_npm_install(
+        version=args.version,
+        repository_root=args.repository_root,
+        platform_package_root=args.platform_package_root,
+        image=args.image,
+        node_target=args.node_target,
+    )
+
+
+if __name__ == "__main__":
+    main()
