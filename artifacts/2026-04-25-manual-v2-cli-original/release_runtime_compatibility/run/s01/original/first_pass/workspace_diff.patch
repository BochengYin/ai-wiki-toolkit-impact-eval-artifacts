--- /dev/null
+++ b/src/ai_wiki_toolkit/npm_smoke.py
@@ -0,0 +1,37 @@
+"""Helpers for npm package smoke-test staging."""
+
+from __future__ import annotations
+
+from collections.abc import Iterable
+import json
+
+from ai_wiki_toolkit.npm_distribution import PlatformPackage, load_platform_packages
+
+DEFAULT_LINUX_SMOKE_IMAGE = "node:24-bookworm"
+DEFAULT_LINUX_SMOKE_TARGET = "linux-x64"
+SMOKE_CONTAINER_DIR = "/smoke"
+
+
+def find_smoke_platform_package(
+    node_target: str = DEFAULT_LINUX_SMOKE_TARGET,
+    packages: Iterable[PlatformPackage] | None = None,
+) -> PlatformPackage:
+    """Return the platform package used for npm runtime smoke tests."""
+    available = tuple(packages) if packages is not None else load_platform_packages()
+    for package in available:
+        if package.node_target == node_target:
+            return package
+    raise ValueError(f"Unsupported npm smoke target: {node_target}")
+
+
+def render_smoke_meta_package_json(
+    root_package_json: dict[str, object],
+    package: PlatformPackage,
+    platform_tarball_path: str,
+) -> str:
+    """Render a temporary meta package that installs a local platform tarball."""
+    payload = dict(root_package_json)
+    payload["optionalDependencies"] = {
+        package.package_name: f"file:{platform_tarball_path}",
+    }
+    return json.dumps(payload, indent=2) + "\n"
