--- /dev/null
+++ b/tests/test_npm_smoke.py
@@ -0,0 +1,45 @@
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+from ai_wiki_toolkit.npm_smoke import (
+    DEFAULT_LINUX_SMOKE_IMAGE,
+    DEFAULT_LINUX_SMOKE_TARGET,
+    SMOKE_CONTAINER_DIR,
+    find_smoke_platform_package,
+    render_smoke_meta_package_json,
+)
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def test_default_linux_smoke_target_matches_bookworm_node_image() -> None:
+    package = find_smoke_platform_package()
+
+    assert DEFAULT_LINUX_SMOKE_TARGET == "linux-x64"
+    assert DEFAULT_LINUX_SMOKE_IMAGE == "node:24-bookworm"
+    assert package.node_target == "linux-x64"
+    assert package.os == ("linux",)
+    assert package.cpu == ("x64",)
+
+
+def test_smoke_meta_package_uses_local_linux_platform_tarball_only() -> None:
+    root_package_json = json.loads((ROOT / "package.json").read_text(encoding="utf-8"))
+    package = find_smoke_platform_package()
+
+    rendered = json.loads(
+        render_smoke_meta_package_json(
+            root_package_json=root_package_json,
+            package=package,
+            platform_tarball_path=f"{SMOKE_CONTAINER_DIR}/linux-package.tgz",
+        )
+    )
+
+    assert rendered["name"] == root_package_json["name"]
+    assert rendered["version"] == root_package_json["version"]
+    assert rendered["bin"] == root_package_json["bin"]
+    assert rendered["files"] == root_package_json["files"]
+    assert rendered["optionalDependencies"] == {
+        package.package_name: f"file:{SMOKE_CONTAINER_DIR}/linux-package.tgz"
+    }
