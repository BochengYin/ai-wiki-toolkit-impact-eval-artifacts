+from __future__ import annotations
+
+import importlib.util
+from pathlib import Path
+from types import ModuleType
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def _load_script(name: str) -> ModuleType:
+    script_path = ROOT / "scripts" / f"{name}.py"
+    spec = importlib.util.spec_from_file_location(name, script_path)
+    assert spec is not None
+    assert spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def test_linux_build_script_uses_containerized_pyinstaller_baseline(tmp_path: Path) -> None:
+    script = _load_script("build_linux_release_in_container")
+
+    command = script.docker_build_command(
+        tmp_path,
+        image="python:3.11-bullseye",
+        platform="linux/amd64",
+        user="1000:1000",
+    )
+
+    assert command[:5] == ["docker", "run", "--rm", "--platform", "linux/amd64"]
+    assert command[command.index("-v") + 1] == f"{tmp_path.resolve()}:/work"
+    assert command[command.index("--user") + 1] == "1000:1000"
+    assert "python:3.11-bullseye" in command
+    assert "python -m PyInstaller" in command[-1]
+    assert 'python -m pip install ".[release]"' in command[-1]
+
+
+def test_linux_runtime_script_mounts_binary_into_runtime_container(tmp_path: Path) -> None:
+    script = _load_script("check_linux_runtime_matrix")
+    binary_path = tmp_path / "aiwiki-toolkit"
+    binary_path.touch()
+
+    command = script.docker_runtime_command(
+        binary_path,
+        image="node:24-bookworm",
+        platform="linux/amd64",
+    )
+
+    assert command[:5] == ["docker", "run", "--rm", "--platform", "linux/amd64"]
+    assert command[command.index("-v") + 1] == (
+        f"{binary_path.resolve()}:/usr/local/bin/aiwiki-toolkit:ro"
+    )
+    assert command[-3:] == [
+        "node:24-bookworm",
+        "/usr/local/bin/aiwiki-toolkit",
+        "--version",
+    ]
+
+
+def test_linux_runtime_script_checks_older_and_current_runtime_images() -> None:
+    script = _load_script("check_linux_runtime_matrix")
+
+    assert script.DEFAULT_IMAGES == ("debian:bullseye-slim", "node:24-bookworm")
