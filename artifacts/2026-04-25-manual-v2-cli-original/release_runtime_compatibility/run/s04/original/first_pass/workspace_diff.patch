@@ -0,0 +1,112 @@
+"""Run the Linux release binary in runtime containers before publishing."""
+
+from __future__ import annotations
+
+import argparse
+from pathlib import Path
+import subprocess
+import sys
+
+DEFAULT_IMAGES = ("debian:bullseye-slim", "node:24-bookworm")
+DEFAULT_PLATFORM = "linux/amd64"
+CONTAINER_BINARY_PATH = "/usr/local/bin/aiwiki-toolkit"
+
+
+def docker_runtime_command(
+    binary_path: Path,
+    *,
+    image: str,
+    platform: str = DEFAULT_PLATFORM,
+) -> list[str]:
+    return [
+        "docker",
+        "run",
+        "--rm",
+        "--platform",
+        platform,
+        "-v",
+        f"{binary_path.resolve()}:{CONTAINER_BINARY_PATH}:ro",
+        image,
+        CONTAINER_BINARY_PATH,
+        "--version",
+    ]
+
+
+def check_runtime_image(
+    binary_path: Path,
+    *,
+    image: str,
+    expected_output: str,
+    platform: str = DEFAULT_PLATFORM,
+) -> None:
+    result = subprocess.run(
+        docker_runtime_command(binary_path, image=image, platform=platform),
+        capture_output=True,
+        text=True,
+        check=False,
+    )
+    if result.returncode != 0:
+        if result.stdout:
+            print(result.stdout, end="", file=sys.stderr)
+        if result.stderr:
+            print(result.stderr, end="", file=sys.stderr)
+        raise SystemExit(
+            f"{binary_path} failed in {image} with exit code {result.returncode}"
+        )
+
+    output = result.stdout.strip()
+    if output != expected_output:
+        raise SystemExit(
+            f"{binary_path} printed {output!r} in {image}; expected {expected_output!r}"
+        )
+
+
+def parse_args() -> argparse.Namespace:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument(
+        "--binary",
+        type=Path,
+        required=True,
+        help="Linux executable to mount into each runtime container.",
+    )
+    parser.add_argument(
+        "--expected-output",
+        required=True,
+        help="Exact stdout expected from aiwiki-toolkit --version.",
+    )
+    parser.add_argument(
+        "--image",
+        action="append",
+        dest="images",
+        help=(
+            "Runtime container image to check. May be passed multiple times. "
+            f"Defaults to {', '.join(DEFAULT_IMAGES)}."
+        ),
+    )
+    parser.add_argument(
+        "--platform",
+        default=DEFAULT_PLATFORM,
+        help=f"Docker platform used for each runtime check. Defaults to {DEFAULT_PLATFORM}.",
+    )
+    return parser.parse_args()
+
+
+def main() -> None:
+    args = parse_args()
+    binary_path = args.binary.resolve()
+    if not binary_path.exists():
+        raise SystemExit(f"Binary does not exist: {binary_path}")
+
+    images = tuple(args.images or DEFAULT_IMAGES)
+    for image in images:
+        check_runtime_image(
+            binary_path,
+            image=image,
+            expected_output=args.expected_output,
+            platform=args.platform,
+        )
+        print(f"{image}: ok")
+
+
+if __name__ == "__main__":
+    main()
