+++ b/scripts/build_linux_release_in_container.py
@@ -0,0 +1,112 @@
+"""Build the Linux release binary inside an older glibc container."""
+
+from __future__ import annotations
+
+import argparse
+import os
+from pathlib import Path
+import subprocess
+
+DEFAULT_IMAGE = "python:3.11-bullseye"
+DEFAULT_PLATFORM = "linux/amd64"
+CONTAINER_WORKDIR = "/work"
+
+
+def pyinstaller_shell_script() -> str:
+    return "\n".join(
+        [
+            "set -euo pipefail",
+            "python -m venv /tmp/aiwiki-toolkit-release-venv",
+            ". /tmp/aiwiki-toolkit-release-venv/bin/activate",
+            "python -m pip install --upgrade pip",
+            'python -m pip install ".[release]"',
+            "python -m PyInstaller "
+            "--clean "
+            "--noconfirm "
+            "--onefile "
+            "--name aiwiki-toolkit "
+            "--paths src "
+            "--specpath build/pyinstaller "
+            "src/ai_wiki_toolkit/cli.py",
+        ]
+    )
+
+
+def default_docker_user() -> str | None:
+    if os.name != "posix":
+        return None
+    return f"{os.getuid()}:{os.getgid()}"
+
+
+def docker_build_command(
+    repo_dir: Path,
+    *,
+    image: str = DEFAULT_IMAGE,
+    platform: str = DEFAULT_PLATFORM,
+    user: str | None = None,
+) -> list[str]:
+    command = [
+        "docker",
+        "run",
+        "--rm",
+        "--platform",
+        platform,
+        "-e",
+        "HOME=/tmp/aiwiki-toolkit-home",
+        "-v",
+        f"{repo_dir.resolve()}:{CONTAINER_WORKDIR}",
+        "-w",
+        CONTAINER_WORKDIR,
+    ]
+    if user:
+        command.extend(["--user", user])
+    command.extend([image, "bash", "-lc", pyinstaller_shell_script()])
+    return command
+
+
+def parse_args() -> argparse.Namespace:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument(
+        "--repo-dir",
+        type=Path,
+        default=Path.cwd(),
+        help="Repository root to mount into the build container.",
+    )
+    parser.add_argument(
+        "--image",
+        default=DEFAULT_IMAGE,
+        help=f"Container image used for the Linux build. Defaults to {DEFAULT_IMAGE}.",
+    )
+    parser.add_argument(
+        "--platform",
+        default=DEFAULT_PLATFORM,
+        help=f"Docker platform used for the build. Defaults to {DEFAULT_PLATFORM}.",
+    )
+    parser.add_argument(
+        "--docker-user",
+        default=default_docker_user(),
+        help="UID:GID passed to docker run. Use an empty string to run as the image default user.",
+    )
+    return parser.parse_args()
+
+
+def main() -> None:
+    args = parse_args()
+    repo_dir = args.repo_dir.resolve()
+    if not (repo_dir / "pyproject.toml").exists():
+        raise SystemExit(f"Repository root does not contain pyproject.toml: {repo_dir}")
+
+    user = args.docker_user or None
+    subprocess.run(
+        docker_build_command(
+            repo_dir=repo_dir,
+            image=args.image,
+            platform=args.platform,
+            user=user,
+        ),
+        check=True,
+    )
+
+
+if __name__ == "__main__":
+    main()
