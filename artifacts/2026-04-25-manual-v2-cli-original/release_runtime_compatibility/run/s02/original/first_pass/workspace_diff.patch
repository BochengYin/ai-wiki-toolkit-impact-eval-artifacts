@@ -0,0 +1,55 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+ROOT_DIR="${1:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"
+PLATFORM_PACKAGES_DIR="${PLATFORM_PACKAGES_DIR:-$ROOT_DIR/build/npm-platform-packages}"
+PACK_DIR="${NPM_SMOKE_PACK_DIR:-$ROOT_DIR/build/npm-smoke}"
+IMAGE="${NPM_SMOKE_IMAGE:-node:24-bookworm}"
+
+if ! command -v docker >/dev/null 2>&1; then
+  echo "docker is required for the Linux npm install smoke test." >&2
+  exit 1
+fi
+
+if ! command -v node >/dev/null 2>&1; then
+  echo "node is required to resolve package metadata for the npm smoke test." >&2
+  exit 1
+fi
+
+if ! command -v npm >/dev/null 2>&1; then
+  echo "npm is required to pack local npm packages for the smoke test." >&2
+  exit 1
+fi
+
+EXPECTED_VERSION="${EXPECTED_VERSION:-$(node -e "process.stdout.write(require(process.argv[1]).version)" "$ROOT_DIR/package.json")}"
+LINUX_PACKAGE_NAME="${LINUX_PACKAGE_NAME:-$(node -e "process.stdout.write(require(process.argv[1])['linux-x64'].package_name)" "$ROOT_DIR/npm/platform-targets.json")}"
+LINUX_PACKAGE_DIR="$PLATFORM_PACKAGES_DIR/$LINUX_PACKAGE_NAME"
+
+if [ ! -d "$LINUX_PACKAGE_DIR" ]; then
+  echo "Expected staged Linux package directory at $LINUX_PACKAGE_DIR." >&2
+  exit 1
+fi
+
+rm -rf "$PACK_DIR"
+mkdir -p "$PACK_DIR"
+export npm_config_cache="${npm_config_cache:-$PACK_DIR/npm-cache}"
+
+platform_tgz_name="$(cd "$LINUX_PACKAGE_DIR" && npm pack --silent --pack-destination "$PACK_DIR")"
+meta_tgz_name="$(cd "$ROOT_DIR" && npm pack --silent --ignore-scripts --pack-destination "$PACK_DIR")"
+
+docker run --rm --platform linux/amd64 \
+  -e EXPECTED_VERSION="$EXPECTED_VERSION" \
+  -e PLATFORM_TARBALL="/packages/$platform_tgz_name" \
+  -e META_TARBALL="/packages/$meta_tgz_name" \
+  -v "$PACK_DIR:/packages:ro" \
+  "$IMAGE" \
+  bash -euo pipefail -c '
+    npm install -g "$PLATFORM_TARBALL" "$META_TARBALL"
+    output="$(aiwiki-toolkit --version)"
+    printf "%s\n" "$output"
+    expected="ai-wiki-toolkit ${EXPECTED_VERSION}"
+    if [ "$output" != "$expected" ]; then
+      printf "Expected %s, got %s\n" "$expected" "$output" >&2
+      exit 1
+    fi
+  '
