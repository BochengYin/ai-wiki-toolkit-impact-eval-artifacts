@@ -0,0 +1,33 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+version="${1:?package version is required, for example 0.1.7}"
+runtime_image="${2:-node:24-bookworm}"
+package_version="${version#v}"
+smoke_dir="build/npm-smoke-tarballs"
+
+rm -rf "$smoke_dir"
+mkdir -p "$smoke_dir"
+
+npm pack ./build/npm-platform-packages/ai-wiki-toolkit-linux-x64 \
+  --pack-destination "$smoke_dir"
+npm pack --ignore-scripts --pack-destination "$smoke_dir"
+
+smoke_dir="$(cd "$smoke_dir" && pwd)"
+expected_output="ai-wiki-toolkit ${package_version}"
+
+docker run --rm --platform linux/amd64 \
+  -e EXPECTED_OUTPUT="$expected_output" \
+  -e PACKAGE_VERSION="$package_version" \
+  -v "$smoke_dir:/npm-smoke:ro" \
+  "$runtime_image" \
+  bash -euo pipefail -c '
+    npm install -g --offline \
+      "/npm-smoke/ai-wiki-toolkit-linux-x64-${PACKAGE_VERSION}.tgz" \
+      "/npm-smoke/ai-wiki-toolkit-${PACKAGE_VERSION}.tgz"
+    actual="$(aiwiki-toolkit --version)"
+    if [ "$actual" != "$EXPECTED_OUTPUT" ]; then
+      printf "Expected %s, got %s\n" "$EXPECTED_OUTPUT" "$actual" >&2
+      exit 1
+    fi
+  '
