new file mode 100644
index 0000000..aa11b22
--- /dev/null
+++ b/scripts/smoke_linux_release_runtime.sh
@@ -0,0 +1,36 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+version="${1:?release version is required, for example v0.1.7}"
+asset_dir="${2:?asset directory is required}"
+runtime_image="${3:?runtime image is required, for example node:24-bookworm}"
+
+case "$version" in
+  v*)
+    release_tag="$version"
+    package_version="${version#v}"
+    ;;
+  *)
+    release_tag="v$version"
+    package_version="$version"
+    ;;
+esac
+
+asset_dir="$(cd "$asset_dir" && pwd)"
+archive_name="ai-wiki-toolkit-${release_tag}-linux-x64.tar.gz"
+expected_output="ai-wiki-toolkit ${package_version}"
+
+docker run --rm --platform linux/amd64 \
+  -e ARCHIVE_NAME="$archive_name" \
+  -e EXPECTED_OUTPUT="$expected_output" \
+  -v "$asset_dir:/release-assets:ro" \
+  "$runtime_image" \
+  bash -euo pipefail -c '
+    mkdir -p /tmp/aiwiki-toolkit-smoke
+    tar -xzf "/release-assets/${ARCHIVE_NAME}" -C /tmp/aiwiki-toolkit-smoke
+    actual="$(/tmp/aiwiki-toolkit-smoke/aiwiki-toolkit --version)"
+    if [ "$actual" != "$EXPECTED_OUTPUT" ]; then
+      printf "Expected %s, got %s\n" "$EXPECTED_OUTPUT" "$actual" >&2
+      exit 1
+    fi
+  '
