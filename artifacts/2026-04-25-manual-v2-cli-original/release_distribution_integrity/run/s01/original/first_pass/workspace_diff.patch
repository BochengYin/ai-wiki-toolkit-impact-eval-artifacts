+function detectLibc(platform = process.platform) {
+  if (platform !== "linux") {
+    return null;
+  }
+
+  if (!process.report || typeof process.report.getReport !== "function") {
+    return "glibc";
+  }
+
+  const report = process.report.getReport();
+  const header = report && report.header ? report.header : {};
+  return header.glibcVersionRuntime || header.glibcVersionCompiler
+    ? "glibc"
+    : "musl";
+}
+
+function currentTarget(
+  platform = process.platform,
+  arch = process.arch,
+  libc = detectLibc(platform),
+) {
+  const targetKey = platform === "linux" && libc === "musl"
+    ? `${platform}-musl-${arch}`
+    : `${platform}-${arch}`;
+  return TARGETS[targetKey] || null;
 }
 
 function resolvePlatformPackageRoot(targetInfo) {
@@ -23,6 +46,7 @@ function installedBinaryPath(targetInfo) {
 module.exports = {
