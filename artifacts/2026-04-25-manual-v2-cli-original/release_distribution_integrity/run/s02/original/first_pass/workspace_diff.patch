 const TARGETS = require("./platform-targets.json");
 
-function currentTarget(platform = process.platform, arch = process.arch) {
-  return TARGETS[`${platform}-${arch}`] || null;
+function detectLibc(platform = process.platform) {
+  if (platform !== "linux") {
+    return null;
+  }
+
+  if (process.report && typeof process.report.getReport === "function") {
+    const report = process.report.getReport();
+    if (report.header && report.header.glibcVersionRuntime) {
+      return "glibc";
+    }
+  }
+
+  const ldd = spawnSync("ldd", ["--version"], {
+    encoding: "utf8",
+    windowsHide: true,
+  });
+  const output = `${ldd.stdout || ""}\n${ldd.stderr || ""}`.toLowerCase();
+  if (output.includes("musl")) {
+    return "musl";
+  }
+  if (output.includes("glibc") || output.includes("gnu libc")) {
+    return "glibc";
+  }
+
+  return "glibc";
+}
+
+function targetKey(platform = process.platform, arch = process.arch, libc = detectLibc(platform)) {
+  if (platform === "linux" && libc === "musl") {
+    return `linux-musl-${arch}`;
+  }
+  return `${platform}-${arch}`;
+}
+
+function currentTarget(
+  platform = process.platform,
+  arch = process.arch,
+  libc = detectLibc(platform),
+) {
+  return TARGETS[targetKey(platform, arch, libc)] || null;
 }
 
 function resolvePlatformPackageRoot(targetInfo) {
