+function detectedLinuxLibc(platform = process.platform) {
+  if (platform !== "linux") {
+    return null;
+  }
+
+  const report = process.report?.getReport?.();
+  if (report?.header?.glibcVersionRuntime) {
+    return "glibc";
+  }
+
+  return "musl";
+}
+
+function targetKey(platform, arch, libc) {
+  if (platform === "linux") {
+    if (libc === "musl") {
+      return `linux-musl-${arch}`;
+    }
+    if (libc === "glibc") {
+      return `linux-${arch}`;
+    }
+    return null;
+  }
+
+  return `${platform}-${arch}`;
+}
+
+function currentTarget(
+  platform = process.platform,
+  arch = process.arch,
+  libc = detectedLinuxLibc(platform),
+) {
+  const key = targetKey(platform, arch, libc);
+  return key ? TARGETS[key] || null : null;
 }
 
