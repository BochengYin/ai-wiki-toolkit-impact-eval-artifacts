-function currentTarget(platform = process.platform, arch = process.arch) {
-  return TARGETS[`${platform}-${arch}`] || null;
+function detectLinuxLibc(platform = process.platform) {
+  if (platform !== "linux") {
+    return null;
+  }
+
+  if (process.report && typeof process.report.getReport === "function") {
+    const report = process.report.getReport();
+    if (report.header && report.header.glibcVersionRuntime) {
+      return "glibc";
+    }
+  }
+
+  try {
+    const lddBinary = fs.readFileSync("/usr/bin/ldd", "utf8").toLowerCase();
+    if (lddBinary.includes("musl")) {
+      return "musl";
+    }
+  } catch (error) {
+    // Fall through to executing ldd when the binary cannot be read as text.
+  }
+
+  const result = spawnSync("ldd", ["--version"], {
+    encoding: "utf8",
+  });
+  const output = `${result.stdout || ""}${result.stderr || ""}`.toLowerCase();
+  if (output.includes("musl")) {
+    return "musl";
+  }
+
+  return "glibc";
+}
+
+function targetKey(platform = process.platform, arch = process.arch, libc = undefined) {
+  if (platform === "linux" && arch === "x64") {
+    const resolvedLibc = libc || detectLinuxLibc(platform);
+    if (resolvedLibc === "musl") {
+      return "linux-musl-x64";
+    }
+  }
+
+  return `${platform}-${arch}`;
+}
+
+function currentTarget(platform = process.platform, arch = process.arch, libc = undefined) {
+  return TARGETS[targetKey(platform, arch, libc)] || null;
 }
 
 function resolvePlatformPackageRoot(targetInfo) {
@@ -23,6 +69,8 @@ function installedBinaryPath(targetInfo) {
 module.exports = {
   TARGETS,
   currentTarget,
+  detectLinuxLibc,
