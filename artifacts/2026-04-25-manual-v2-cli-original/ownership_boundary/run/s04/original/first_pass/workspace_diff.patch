+"""Contributor branch and pull request flow helpers."""
+
+from __future__ import annotations
+
+import argparse
+from collections.abc import Callable, Sequence
+from dataclasses import dataclass
+from datetime import date, datetime
+from pathlib import Path
+import re
+import subprocess
+import sys
+
+from ai_wiki_toolkit.paths import RepoRootNotFoundError, resolve_repo_root
+
+BRANCH_KINDS = ("feature", "chore", "fix")
+BRANCH_NAME_PATTERN = re.compile(
+    r"^(?:feature|chore|fix)/(?P<branch_date>\d{4}_\d{2}_\d{2})_[a-z0-9][a-z0-9_-]*$"
+)
+BRANCH_NAME_HELP = (
+    "feature/YYYY_MM_DD_description, chore/YYYY_MM_DD_description, "
+    "or fix/YYYY_MM_DD_description"
+)
+DATE_PATTERN = re.compile(r"^\d{4}_\d{2}_\d{2}$")
+DESCRIPTION_SEPARATOR_RE = re.compile(r"[^a-z0-9]+")
+DESCRIPTION_UNDERSCORE_RE = re.compile(r"_+")
+
+CommandRunner = Callable[..., subprocess.CompletedProcess[str]]
+
+
+class PrFlowError(RuntimeError):
+    """Raised when the branch and pull request flow cannot continue."""
+
+
+@dataclass(frozen=True)
+class FlowResult:
+    branch: str
+
+
+def normalize_description(description: str) -> str:
+    normalized = DESCRIPTION_SEPARATOR_RE.sub("_", description.strip().lower())
+    normalized = DESCRIPTION_UNDERSCORE_RE.sub("_", normalized).strip("_")
+    if not normalized:
+        raise PrFlowError("Branch description must contain at least one letter or number.")
+    return normalized
+
+
+def parse_branch_date(value: str | None) -> str:
+    if value is None:
+        return date.today().strftime("%Y_%m_%d")
+    if not DATE_PATTERN.match(value):
+        raise PrFlowError("Branch date must use YYYY_MM_DD format.")
+    try:
+        datetime.strptime(value, "%Y_%m_%d")
+    except ValueError as exc:
+        raise PrFlowError("Branch date must be a real calendar date.") from exc
+    return value
+
+
+def build_branch_name(kind: str, description: str, *, branch_date: str | None = None) -> str:
+    if kind not in BRANCH_KINDS:
+        raise PrFlowError(f"Branch kind must be one of: {', '.join(BRANCH_KINDS)}.")
+    return f"{kind}/{parse_branch_date(branch_date)}_{normalize_description(description)}"
+
+
+def validate_branch_name(branch: str) -> None:
+    match = BRANCH_NAME_PATTERN.match(branch)
+    if not match:
+        raise PrFlowError(f"Branch name must match {BRANCH_NAME_HELP}.")
+    parse_branch_date(match.group("branch_date"))
+
+
+def _runner_or_default(runner: CommandRunner | None) -> CommandRunner:
+    return runner or subprocess.run
+
+
+def _run(
+    args: Sequence[str],
+    *,
+    repo_root: Path,
+    runner: CommandRunner | None = None,
+    capture_output: bool = False,
+) -> subprocess.CompletedProcess[str]:
+    try:
+        result = _runner_or_default(runner)(
+            list(args),
+            cwd=repo_root,
+            capture_output=capture_output,
+            text=True,
+            check=False,
+        )
+    except FileNotFoundError as exc:
+        raise PrFlowError(f"Required command not found: {args[0]}") from exc
+
+    if result.returncode == 0:
+        return result
+
+    detail = ""
+    if result.stderr:
+        detail = f"\n{result.stderr.strip()}"
+    raise PrFlowError(f"Command failed: {' '.join(args)}{detail}")
+
+
+def _stdout(
+    args: Sequence[str],
+    *,
+    repo_root: Path,
+    runner: CommandRunner | None = None,
+) -> str:
+    return _run(args, repo_root=repo_root, runner=runner, capture_output=True).stdout.strip()
+
+
+def current_branch(repo_root: Path, *, runner: CommandRunner | None = None) -> str:
+    branch = _stdout(["git", "branch", "--show-current"], repo_root=repo_root, runner=runner)
+    if not branch:
+        raise PrFlowError("Detached HEAD is not supported for this workflow.")
+    return branch
+
+
+def require_clean_worktree(repo_root: Path, *, runner: CommandRunner | None = None) -> None:
+    status = _stdout(["git", "status", "--porcelain"], repo_root=repo_root, runner=runner)
+    if status:
+        raise PrFlowError("Commit or stash local changes before continuing.")
+
+
+def _resolve_repo(repo_root: Path | None) -> Path:
+    try:
+        return (repo_root or resolve_repo_root()).resolve()
+    except RepoRootNotFoundError as exc:
+        raise PrFlowError(str(exc)) from exc
+
+
+def start_flow(
+    kind: str,
+    description: str,
+    *,
+    branch_date: str | None = None,
+    repo_root: Path | None = None,
+    runner: CommandRunner | None = None,
+) -> FlowResult:
+    root = _resolve_repo(repo_root)
+    branch = build_branch_name(kind, description, branch_date=branch_date)
+    current = current_branch(root, runner=runner)
+    if current != "main":
+        raise PrFlowError("Start new contributor branches from main.")
+
+    require_clean_worktree(root, runner=runner)
+    _run(["git", "pull", "--ff-only"], repo_root=root, runner=runner)
+    _run(["git", "switch", "-c", branch], repo_root=root, runner=runner)
+    return FlowResult(branch=branch)
+
+
+def create_flow(
+    *,
+    repo_root: Path | None = None,
+    runner: CommandRunner | None = None,
+) -> FlowResult:
+    root = _resolve_repo(repo_root)
+    branch = current_branch(root, runner=runner)
+    if branch == "main":
+        raise PrFlowError("Create pull requests from a contributor branch, not main.")
+    validate_branch_name(branch)
+    require_clean_worktree(root, runner=runner)
+
+    _run(["git", "push", "-u", "origin", branch], repo_root=root, runner=runner)
+    _run(
+        ["git", "ls-remote", "--exit-code", "--heads", "origin", branch],
+        repo_root=root,
+        runner=runner,
+    )
+    _run(["gh", "pr", "create", "--fill"], repo_root=root, runner=runner)
+    return FlowResult(branch=branch)
+
+
+def finish_flow(
+    *,
+    repo_root: Path | None = None,
+    runner: CommandRunner | None = None,
+) -> FlowResult:
+    root = _resolve_repo(repo_root)
+    branch = current_branch(root, runner=runner)
+    if branch == "main":
+        raise PrFlowError("Finish this workflow from the contributor branch after its PR is merged.")
+    validate_branch_name(branch)
+
+    merged = _stdout(
+        [
+            "gh",
+            "pr",
+            "view",
+            "--json",
+            "state,mergedAt",
+            "--jq",
+            '.state == "MERGED" or .mergedAt != null',
+        ],
+        repo_root=root,
+        runner=runner,
+    )
+    if merged.lower() != "true":
+        raise PrFlowError(f"Pull request for {branch} is not merged yet.")
+
+    _run(["git", "switch", "main"], repo_root=root, runner=runner)
+    _run(["git", "pull", "--ff-only"], repo_root=root, runner=runner)
+    return FlowResult(branch=branch)
+
+
+def build_parser() -> argparse.ArgumentParser:
+    parser = argparse.ArgumentParser(description=__doc__)
+    subparsers = parser.add_subparsers(dest="command", required=True)
+
+    start = subparsers.add_parser(
+        "start",
+        help="Create a dated contributor branch from main.",
+    )
+    start.add_argument("kind", choices=BRANCH_KINDS, help="Branch kind.")
+    start.add_argument(
+        "description",
+        nargs="+",
+        help="Short branch description. It is normalized into the branch name.",
+    )
+    start.add_argument(
+        "--date",
+        dest="branch_date",
+        help="Override the branch date for tests or prepared branches. Format: YYYY_MM_DD.",
+    )
+
+    subparsers.add_parser(
+        "create",
+        help="Push the current contributor branch and open a pull request.",
+    )
+    subparsers.add_parser(
+        "finish",
+        help="After the pull request is merged, switch back to main and sync it.",
+    )
+    return parser
+
+
+def main(argv: Sequence[str] | None = None) -> int:
+    args = build_parser().parse_args(argv)
+    try:
+        if args.command == "start":
+            result = start_flow(
+                args.kind,
+                " ".join(args.description),
+                branch_date=args.branch_date,
+            )
+            print(f"Created branch: {result.branch}")
+        elif args.command == "create":
+            result = create_flow()
+            print(f"Created pull request from: {result.branch}")
+        elif args.command == "finish":
+            result = finish_flow()
+            print(f"Returned to main after merged PR for: {result.branch}")
+        else:
+            raise AssertionError(f"unhandled command: {args.command}")
+    except PrFlowError as exc:
+        print(str(exc), file=sys.stderr)
+        return 1
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
