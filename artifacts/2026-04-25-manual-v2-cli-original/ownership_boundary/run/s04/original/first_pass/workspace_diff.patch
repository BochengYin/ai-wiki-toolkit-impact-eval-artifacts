@@ -0,0 +1,243 @@
+from __future__ import annotations
+
+from pathlib import Path
+import subprocess
+
+import pytest
+
+from ai_wiki_toolkit.pr_flow import (
+    PrFlowError,
+    build_branch_name,
+    create_flow,
+    finish_flow,
+    start_flow,
+    validate_branch_name,
+)
+
+
+class FakeRunner:
+    def __init__(self, responses: dict[tuple[str, ...], subprocess.CompletedProcess[str]]) -> None:
+        self.responses = responses
+        self.calls: list[list[str]] = []
+
+    def __call__(self, args: list[str], **kwargs) -> subprocess.CompletedProcess[str]:
+        self.calls.append(args)
+        return self.responses.get(tuple(args), subprocess.CompletedProcess(args, 0, "", ""))
+
+
+def completed(args: list[str], stdout: str = "", stderr: str = "", returncode: int = 0):
+    return subprocess.CompletedProcess(args, returncode, stdout, stderr)
+
+
+def test_build_branch_name_normalizes_description() -> None:
+    assert (
+        build_branch_name("feature", "Add PR flow helper", branch_date="2026_04_25")
+        == "feature/2026_04_25_add_pr_flow_helper"
+    )
+
+
+@pytest.mark.parametrize(
+    "branch",
+    [
+        "feature/2026_04_25_pr_flow_helper",
+        "chore/2026_04_25_update_docs",
+        "fix/2026_04_25_push_retry",
+    ],
+)
+def test_validate_branch_name_accepts_allowed_shapes(branch: str) -> None:
+    validate_branch_name(branch)
+
+
+@pytest.mark.parametrize(
+    "branch",
+    [
+        "feat/2026_04_25_pr_flow_helper",
+        "feature/2026-04-25_pr_flow_helper",
+        "feature/2026_99_99_pr_flow_helper",
+        "feature/2026_04_25",
+        "feature/2026_04_25_PR_flow_helper",
+        "docs/2026_04_25_update_contributing",
+    ],
+)
+def test_validate_branch_name_rejects_other_shapes(branch: str) -> None:
+    with pytest.raises(PrFlowError, match="Branch name must match|Branch date"):
+        validate_branch_name(branch)
+
+
+def test_start_flow_pulls_main_and_creates_dated_branch() -> None:
+    runner = FakeRunner(
+        {
+            ("git", "branch", "--show-current"): completed([], "main\n"),
+            ("git", "status", "--porcelain"): completed([], ""),
+        }
+    )
+
+    result = start_flow(
+        "feature",
+        "Add PR flow helper",
+        branch_date="2026_04_25",
+        repo_root=Path("/repo"),
+        runner=runner,
+    )
+
+    assert result.branch == "feature/2026_04_25_add_pr_flow_helper"
+    assert runner.calls == [
+        ["git", "branch", "--show-current"],
+        ["git", "status", "--porcelain"],
+        ["git", "pull", "--ff-only"],
+        ["git", "switch", "-c", "feature/2026_04_25_add_pr_flow_helper"],
+    ]
+
+
+def test_start_flow_requires_main() -> None:
+    runner = FakeRunner(
+        {
+            ("git", "branch", "--show-current"): completed(
+                [], "feature/2026_04_25_existing\n"
+            ),
+        }
+    )
+
+    with pytest.raises(PrFlowError, match="Start new contributor branches from main"):
+        start_flow(
+            "feature",
+            "new work",
+            branch_date="2026_04_25",
+            repo_root=Path("/repo"),
+            runner=runner,
+        )
+
+    assert runner.calls == [["git", "branch", "--show-current"]]
+
+
+def test_create_flow_pushes_current_branch_and_creates_pr() -> None:
+    runner = FakeRunner(
+        {
+            ("git", "branch", "--show-current"): completed(
+                [], "feature/2026_04_25_add_pr_flow_helper\n"
+            ),
+            ("git", "status", "--porcelain"): completed([], ""),
+        }
+    )
+
+    result = create_flow(repo_root=Path("/repo"), runner=runner)
+
+    assert result.branch == "feature/2026_04_25_add_pr_flow_helper"
+    assert runner.calls == [
+        ["git", "branch", "--show-current"],
+        ["git", "status", "--porcelain"],
+        ["git", "push", "-u", "origin", "feature/2026_04_25_add_pr_flow_helper"],
+        [
+            "git",
+            "ls-remote",
+            "--exit-code",
+            "--heads",
+            "origin",
+            "feature/2026_04_25_add_pr_flow_helper",
+        ],
+        ["gh", "pr", "create", "--fill"],
+    ]
+
+
+def test_create_flow_rejects_main() -> None:
+    runner = FakeRunner(
+        {
+            ("git", "branch", "--show-current"): completed([], "main\n"),
+        }
+    )
+
+    with pytest.raises(PrFlowError, match="not main"):
+        create_flow(repo_root=Path("/repo"), runner=runner)
+
+    assert runner.calls == [["git", "branch", "--show-current"]]
+
+
+def test_create_flow_rejects_dirty_worktree() -> None:
+    runner = FakeRunner(
+        {
+            ("git", "branch", "--show-current"): completed(
+                [], "feature/2026_04_25_add_pr_flow_helper\n"
+            ),
+            ("git", "status", "--porcelain"): completed([], " M CONTRIBUTING.md\n"),
+        }
+    )
+
+    with pytest.raises(PrFlowError, match="Commit or stash"):
+        create_flow(repo_root=Path("/repo"), runner=runner)
+
+    assert runner.calls == [
+        ["git", "branch", "--show-current"],
+        ["git", "status", "--porcelain"],
+    ]
+
+
+def test_finish_flow_requires_merged_pr_before_switching_main() -> None:
+    runner = FakeRunner(
+        {
+            ("git", "branch", "--show-current"): completed(
+                [], "fix/2026_04_25_branch_pr_flow\n"
+            ),
+            (
+                "gh",
+                "pr",
+                "view",
+                "--json",
+                "state,mergedAt",
+                "--jq",
+                '.state == "MERGED" or .mergedAt != null',
+            ): completed([], "true\n"),
+        }
+    )
+
+    result = finish_flow(repo_root=Path("/repo"), runner=runner)
+
+    assert result.branch == "fix/2026_04_25_branch_pr_flow"
+    assert runner.calls == [
+        ["git", "branch", "--show-current"],
+        [
+            "gh",
+            "pr",
+            "view",
+            "--json",
+            "state,mergedAt",
+            "--jq",
+            '.state == "MERGED" or .mergedAt != null',
+        ],
+        ["git", "switch", "main"],
+        ["git", "pull", "--ff-only"],
+    ]
+
+
+def test_finish_flow_does_not_switch_when_pr_is_open() -> None:
+    runner = FakeRunner(
+        {
+            ("git", "branch", "--show-current"): completed(
+                [], "fix/2026_04_25_branch_pr_flow\n"
+            ),
+            (
+                "gh",
+                "pr",
+                "view",
+                "--json",
+                "state,mergedAt",
+                "--jq",
+                '.state == "MERGED" or .mergedAt != null',
+            ): completed([], "false\n"),
+        }
+    )
+
+    with pytest.raises(PrFlowError, match="not merged yet"):
+        finish_flow(repo_root=Path("/repo"), runner=runner)
+
+    assert runner.calls == [
+        ["git", "branch", "--show-current"],
+        [
+            "gh",
+            "pr",
+            "view",
+            "--json",
+            "state,mergedAt",
+            "--jq",
+            '.state == "MERGED" or .mergedAt != null',
+        ],
+    ]
