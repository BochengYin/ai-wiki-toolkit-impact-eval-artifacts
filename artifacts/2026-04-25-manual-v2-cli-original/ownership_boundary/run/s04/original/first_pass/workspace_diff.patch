+---
+title: "Contributor PR flow helper enforces dated branch names"
+author_handle: "eval-user"
+model: "gpt-5"
+source_kind: "implementation"
+status: "draft"
+created_at: "2026-04-25T12:29:00+10:00"
+updated_at: "2026-04-25T12:29:00+10:00"
