+++ b/scripts/contributor_pr.py
@@ -0,0 +1,173 @@
+"""Help contributors follow this repository's branch-and-PR workflow."""
+
+from __future__ import annotations
+
+import argparse
+from datetime import date
+from pathlib import Path
+import subprocess
+import sys
+
+ROOT = Path(__file__).resolve().parents[1]
+SRC = ROOT / "src"
+if str(SRC) not in sys.path:
+    sys.path.insert(0, str(SRC))
+
+from ai_wiki_toolkit.contributor_workflow import (
+    ALLOWED_BRANCH_KINDS,
+    ContributorWorkflowError,
+    build_branch_name,
+    parse_branch_date,
+    validate_contributor_branch_name,
+    validate_finish_confirmation,
+    validate_push_branch,
+    validate_start_state,
+)
+
+
+def _run_git(repo: Path, args: list[str], *, dry_run: bool = False) -> None:
+    command = ["git", *args]
+    if dry_run:
+        print("+ " + " ".join(command))
+        return
+
+    result = subprocess.run(command, cwd=repo, check=False)
+    if result.returncode != 0:
+        raise SystemExit(result.returncode)
+
+
+def _capture_git(repo: Path, args: list[str]) -> str:
+    result = subprocess.run(
+        ["git", *args],
+        cwd=repo,
+        capture_output=True,
+        check=False,
+        text=True,
+    )
+    if result.returncode != 0:
+        detail = result.stderr.strip() or result.stdout.strip()
+        raise ContributorWorkflowError(detail or f"git {' '.join(args)} failed")
+    return result.stdout.strip()
+
+
+def _current_branch(repo: Path) -> str:
+    branch = _capture_git(repo, ["branch", "--show-current"])
+    if not branch:
+        raise ContributorWorkflowError("Could not determine the current git branch.")
+    return branch
+
+
+def _dirty_worktree(repo: Path) -> bool:
+    return bool(_capture_git(repo, ["status", "--porcelain"]))
+
+
+def _parse_date(value: str | None) -> date | None:
+    if value is None:
+        return None
+    return parse_branch_date(value)
+
+
+def start(args: argparse.Namespace) -> int:
+    repo = args.repo.resolve()
+    branch = build_branch_name(
+        args.kind,
+        " ".join(args.description),
+        branch_date=_parse_date(args.date),
+    )
+    validate_start_state(_current_branch(repo), _dirty_worktree(repo))
+
+    _run_git(repo, ["switch", "-c", branch], dry_run=args.dry_run)
+    print(f"Contributor branch: {branch}")
+    print("After committing changes, run: python scripts/contributor_pr.py push")
+    return 0
+
+
+def push(args: argparse.Namespace) -> int:
+    repo = args.repo.resolve()
+    branch = validate_push_branch(_current_branch(repo))
+
+    _run_git(repo, ["push", "--set-upstream", "origin", branch], dry_run=args.dry_run)
+    print(f"Pushed contributor branch: {branch}")
+    print("Open a pull request from this branch.")
+    print("After the pull request is merged, run: python scripts/contributor_pr.py finish --merged")
+    return 0
+
+
+def finish(args: argparse.Namespace) -> int:
+    repo = args.repo.resolve()
+    validate_finish_confirmation(args.merged)
+    branch = validate_push_branch(_current_branch(repo))
+
+    _run_git(repo, ["switch", "main"], dry_run=args.dry_run)
+    if args.pull:
+        _run_git(repo, ["pull", "--ff-only"], dry_run=args.dry_run)
+    print(f"Returned to main after merged pull request for {branch}.")
+    return 0
+
+
+def validate(args: argparse.Namespace) -> int:
+    repo = args.repo.resolve()
+    branch = args.branch or _current_branch(repo)
+    validate_contributor_branch_name(branch)
+    print(f"Valid contributor branch: {branch}")
+    return 0
+
+
+def parse_args(argv: list[str]) -> argparse.Namespace:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument(
+        "--repo",
+        type=Path,
+        default=Path.cwd(),
+        help="Repository path. Defaults to the current working directory.",
+    )
+    parser.add_argument(
+        "--dry-run",
+        action="store_true",
+        help="Print git commands without running them.",
+    )
+    subparsers = parser.add_subparsers(dest="command", required=True)
+
+    start_parser = subparsers.add_parser("start", help="Create a new contributor branch from main.")
+    start_parser.add_argument("kind", choices=ALLOWED_BRANCH_KINDS)
+    start_parser.add_argument("description", nargs="+", help="Short branch description.")
+    start_parser.add_argument(
+        "--date",
+        help="Override the branch date for deterministic runs. Format: YYYY_MM_DD.",
+    )
+    start_parser.set_defaults(func=start)
+
+    push_parser = subparsers.add_parser("push", help="Push the current contributor branch.")
+    push_parser.set_defaults(func=push)
+
+    finish_parser = subparsers.add_parser("finish", help="Return to main after the PR is merged.")
+    finish_parser.add_argument(
+        "--merged",
+        action="store_true",
+        help="Confirm the pull request for the current branch has been merged.",
+    )
+    finish_parser.add_argument(
+        "--pull",
+        action="store_true",
+        help="Run git pull --ff-only after switching back to main.",
+    )
+    finish_parser.set_defaults(func=finish)
+
+    validate_parser = subparsers.add_parser("validate", help="Validate a contributor branch name.")
+    validate_parser.add_argument("branch", nargs="?", help="Branch name. Defaults to current branch.")
+    validate_parser.set_defaults(func=validate)
+
+    return parser.parse_args(argv)
+
+
+def main(argv: list[str] | None = None) -> int:
+    args = parse_args(argv or sys.argv[1:])
+    try:
+        return args.func(args)
+    except (ContributorWorkflowError, ValueError) as exc:
+        print(str(exc), file=sys.stderr)
+        return 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
