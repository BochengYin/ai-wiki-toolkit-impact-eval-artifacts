@@ -0,0 +1,103 @@
+"""Contributor branch and pull request workflow helpers."""
+
+from __future__ import annotations
+
+from datetime import date
+import re
+
+ALLOWED_BRANCH_KINDS = ("feature", "chore", "fix")
+MAIN_BRANCH = "main"
+
+_DESCRIPTION_SEPARATOR_RE = re.compile(r"[^a-z0-9]+")
+_BRANCH_NAME_RE = re.compile(
+    r"^(?P<kind>feature|chore|fix)/"
+    r"(?P<year>\d{4})_(?P<month>\d{2})_(?P<day>\d{2})_"
+    r"(?P<description>[a-z0-9]+(?:_[a-z0-9]+)*)$"
+)
+
+
+class ContributorWorkflowError(RuntimeError):
+    """Raised when a contributor workflow step is not allowed."""
+
+
+def normalize_branch_description(description: str) -> str:
+    normalized = _DESCRIPTION_SEPARATOR_RE.sub("_", description.strip().lower()).strip("_")
+    if not normalized:
+        raise ValueError("Branch description must include at least one letter or number.")
+    return normalized
+
+
+def parse_branch_date(value: str) -> date:
+    match = re.fullmatch(r"(\d{4})_(\d{2})_(\d{2})", value)
+    if not match:
+        raise ValueError("Branch date must use YYYY_MM_DD.")
+    year, month, day = (int(part) for part in match.groups())
+    return date(year, month, day)
+
+
+def build_branch_name(
+    kind: str,
+    description: str,
+    branch_date: date | None = None,
+) -> str:
+    if kind not in ALLOWED_BRANCH_KINDS:
+        allowed = ", ".join(ALLOWED_BRANCH_KINDS)
+        raise ValueError(f"Branch kind must be one of: {allowed}.")
+    current_date = branch_date or date.today()
+    return f"{kind}/{current_date:%Y_%m_%d}_{normalize_branch_description(description)}"
+
+
+def validate_contributor_branch_name(branch_name: str) -> str:
+    match = _BRANCH_NAME_RE.fullmatch(branch_name)
+    if not match:
+        raise ValueError(
+            "Branch names must match "
+            "feature/YYYY_MM_DD_description, chore/YYYY_MM_DD_description, "
+            "or fix/YYYY_MM_DD_description."
+        )
+
+    try:
+        date(
+            int(match.group("year")),
+            int(match.group("month")),
+            int(match.group("day")),
+        )
+    except ValueError as exc:
+        raise ValueError("Branch date must be a real YYYY_MM_DD date.") from exc
+
+    return branch_name
+
+
+def is_contributor_branch_name(branch_name: str) -> bool:
+    try:
+        validate_contributor_branch_name(branch_name)
+    except ValueError:
+        return False
+    return True
+
+
+def validate_start_state(current_branch: str, dirty_worktree: bool) -> None:
+    if current_branch != MAIN_BRANCH:
+        raise ContributorWorkflowError(
+            f"Start contributor work from `{MAIN_BRANCH}`; current branch is `{current_branch}`."
+        )
+    if dirty_worktree:
+        raise ContributorWorkflowError(
+            f"Start contributor work from a clean `{MAIN_BRANCH}` before making changes."
+        )
+
+
+def validate_push_branch(branch_name: str) -> str:
+    if branch_name == MAIN_BRANCH:
+        raise ContributorWorkflowError("Push contributor changes from a new branch, not `main`.")
+    try:
+        return validate_contributor_branch_name(branch_name)
+    except ValueError as exc:
+        raise ContributorWorkflowError(str(exc)) from exc
+
+
+def validate_finish_confirmation(merged: bool) -> None:
+    if not merged:
+        raise ContributorWorkflowError(
+            "Switch back to `main` only after the pull request is merged; re-run with --merged."
+        )
diff --git a/tests/test_contributor_pr_script.py b/tests/test_contributor_pr_script.py
new file mode 100644
index 0000000..f680fbc
--- /dev/null
+++ b/tests/test_contributor_pr_script.py
@@ -0,0 +1,123 @@
+from __future__ import annotations
+
+from pathlib import Path
+import subprocess
+import sys
+
+ROOT = Path(__file__).resolve().parents[1]
+SCRIPT = ROOT / "scripts" / "contributor_pr.py"
+
+
+def run_git(repo: Path, *args: str) -> subprocess.CompletedProcess[str]:
+    return subprocess.run(
+        ["git", *args],
+        cwd=repo,
+        capture_output=True,
+        check=True,
+        text=True,
+    )
+
+
+def run_helper(repo: Path, *args: str) -> subprocess.CompletedProcess[str]:
+    return subprocess.run(
+        [sys.executable, SCRIPT.as_posix(), "--repo", repo.as_posix(), *args],
+        cwd=ROOT,
+        capture_output=True,
+        check=False,
+        text=True,
+    )
+
+
+def create_git_repo(tmp_path: Path) -> Path:
+    repo = tmp_path / "repo"
+    repo.mkdir()
+    subprocess.run(["git", "init", "-b", "main"], cwd=repo, check=True, capture_output=True)
+    run_git(repo, "config", "user.email", "contributor@example.com")
+    run_git(repo, "config", "user.name", "Contributor")
+    (repo / "README.md").write_text("# Test Repo\n", encoding="utf-8")
+    run_git(repo, "add", "README.md")
+    run_git(repo, "commit", "-m", "Initial commit")
+    return repo
+
+
+def current_branch(repo: Path) -> str:
+    return run_git(repo, "branch", "--show-current").stdout.strip()
+
+
+def test_start_creates_required_contributor_branch_from_clean_main(tmp_path: Path) -> None:
+    repo = create_git_repo(tmp_path)
+
+    result = run_helper(
+        repo,
+        "start",
+        "feature",
+        "Branch helper",
+        "--date",
+        "2026_04_25",
+    )
+
+    assert result.returncode == 0
+    assert current_branch(repo) == "feature/2026_04_25_branch_helper"
+    assert "Contributor branch: feature/2026_04_25_branch_helper" in result.stdout
+
+
+def test_start_rejects_dirty_main_before_creating_branch(tmp_path: Path) -> None:
+    repo = create_git_repo(tmp_path)
+    (repo / "dirty.txt").write_text("started on main\n", encoding="utf-8")
+
+    result = run_helper(
+        repo,
+        "start",
+        "fix",
+        "Dirty main",
+        "--date",
+        "2026_04_25",
+    )
+
+    assert result.returncode == 1
+    assert "clean `main`" in result.stderr
+    assert current_branch(repo) == "main"
+
+
+def test_push_dry_run_requires_valid_non_main_branch(tmp_path: Path) -> None:
+    repo = create_git_repo(tmp_path)
+
+    main_result = run_helper(repo, "--dry-run", "push")
+
+    assert main_result.returncode == 1
+    assert "not `main`" in main_result.stderr
+
+    start_result = run_helper(repo, "start", "chore", "Dry run push", "--date", "2026_04_25")
+    assert start_result.returncode == 0
+
+    branch_result = run_helper(repo, "--dry-run", "push")
+
+    assert branch_result.returncode == 0
+    assert "+ git push --set-upstream origin chore/2026_04_25_dry_run_push" in branch_result.stdout
+
+
+def test_finish_requires_merged_confirmation_before_returning_to_main(tmp_path: Path) -> None:
+    repo = create_git_repo(tmp_path)
+    start_result = run_helper(repo, "start", "fix", "Finish helper", "--date", "2026_04_25")
+    assert start_result.returncode == 0
+
+    unmerged_result = run_helper(repo, "finish")
+
+    assert unmerged_result.returncode == 1
+    assert "after the pull request is merged" in unmerged_result.stderr
+    assert current_branch(repo) == "fix/2026_04_25_finish_helper"
+
+    merged_result = run_helper(repo, "finish", "--merged")
+
+    assert merged_result.returncode == 0
+    assert current_branch(repo) == "main"
+
+
+def test_finish_rejects_main_even_with_merged_confirmation(tmp_path: Path) -> None:
+    repo = create_git_repo(tmp_path)
+
+    result = run_helper(repo, "finish", "--merged")
+
+    assert result.returncode == 1
+    assert "not `main`" in result.stderr
+    assert current_branch(repo) == "main"
