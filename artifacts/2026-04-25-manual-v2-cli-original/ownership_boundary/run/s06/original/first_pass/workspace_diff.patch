index 0000000..7629f6c
--- /dev/null
+++ b/tests/test_contributor_workflow.py
@@ -0,0 +1,82 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from ai_wiki_toolkit.contributor_workflow import (
+    ContributorWorkflowError,
+    build_branch_name,
+    is_contributor_branch_name,
+    normalize_branch_description,
+    parse_branch_date,
+    validate_finish_confirmation,
+    validate_push_branch,
+    validate_start_state,
+)
+
+
+def test_build_branch_name_uses_required_contributor_pattern() -> None:
+    branch_name = build_branch_name(
+        "feature",
+        "Add contributor branch helper",
+        branch_date=date(2026, 4, 25),
+    )
+
+    assert branch_name == "feature/2026_04_25_add_contributor_branch_helper"
+    assert is_contributor_branch_name(branch_name) is True
+
+
+def test_branch_name_validation_accepts_allowed_kinds_and_real_dates() -> None:
+    assert is_contributor_branch_name("feature/2026_04_25_branch_helper") is True
+    assert is_contributor_branch_name("chore/2026_04_25_branch_helper") is True
+    assert is_contributor_branch_name("fix/2026_04_25_branch_helper") is True
+
+    assert is_contributor_branch_name("docs/2026_04_25_branch_helper") is False
+    assert is_contributor_branch_name("feature/2026-04-25-branch-helper") is False
+    assert is_contributor_branch_name("feature/2026_02_31_branch_helper") is False
+    assert is_contributor_branch_name("main") is False
+
+
+def test_normalize_branch_description_requires_letters_or_numbers() -> None:
+    assert normalize_branch_description("Branch & PR helper") == "branch_pr_helper"
+
+    with pytest.raises(ValueError, match="at least one letter or number"):
+        normalize_branch_description(" -- ")
+
+
+def test_parse_branch_date_requires_underscore_date() -> None:
+    assert parse_branch_date("2026_04_25") == date(2026, 4, 25)
+
+    with pytest.raises(ValueError, match="YYYY_MM_DD"):
+        parse_branch_date("2026-04-25")
+
+
+def test_start_state_requires_clean_main() -> None:
+    validate_start_state("main", dirty_worktree=False)
+
+    with pytest.raises(ContributorWorkflowError, match="from `main`"):
+        validate_start_state("feature/2026_04_25_work", dirty_worktree=False)
+
+    with pytest.raises(ContributorWorkflowError, match="clean `main`"):
+        validate_start_state("main", dirty_worktree=True)
+
+
+def test_push_requires_named_contributor_branch_not_main() -> None:
+    assert (
+        validate_push_branch("fix/2026_04_25_branch_validation")
+        == "fix/2026_04_25_branch_validation"
+    )
+
+    with pytest.raises(ContributorWorkflowError, match="not `main`"):
+        validate_push_branch("main")
+
+    with pytest.raises(ContributorWorkflowError, match="Branch names must match"):
+        validate_push_branch("feature/freeform-name")
+
+
+def test_finish_requires_merged_confirmation() -> None:
+    validate_finish_confirmation(True)
+
+    with pytest.raises(ContributorWorkflowError, match="after the pull request is merged"):
+        validate_finish_confirmation(False)
