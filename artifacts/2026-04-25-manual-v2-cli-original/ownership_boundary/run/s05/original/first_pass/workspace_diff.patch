index 0000000..c8c2f39
--- /dev/null
+++ b/scripts/pr_flow.py
@@ -0,0 +1,248 @@
+from __future__ import annotations
+
+import argparse
+import datetime as dt
+import json
+import re
+import shlex
+import subprocess
+import sys
+from dataclasses import dataclass
+from typing import Sequence
+
+
+MAIN_BRANCH = "main"
+ALLOWED_BRANCH_KINDS = ("feature", "chore", "fix")
+BRANCH_NAME_RE = re.compile(
+    r"^(?P<kind>feature|chore|fix)/"
+    r"(?P<year>\d{4})_(?P<month>\d{2})_(?P<day>\d{2})_"
+    r"(?P<description>[a-z0-9]+(?:_[a-z0-9]+)*)$"
+)
+DESCRIPTION_RE = re.compile(r"[^a-z0-9]+")
+
+
+class FlowError(RuntimeError):
+    """Raised when the local branch-and-PR flow should stop."""
+
+
+@dataclass(frozen=True)
+class BranchName:
+    kind: str
+    date: dt.date
+    description: str
+
+
+def normalize_description(description: str) -> str:
+    slug = DESCRIPTION_RE.sub("_", description.strip().lower())
+    slug = re.sub(r"_+", "_", slug).strip("_")
+    if not slug:
+        raise FlowError("branch description must include at least one letter or number")
+    return slug
+
+
+def build_branch_name(kind: str, description: str, *, today: dt.date | None = None) -> str:
+    if kind not in ALLOWED_BRANCH_KINDS:
+        allowed = ", ".join(ALLOWED_BRANCH_KINDS)
+        raise FlowError(f"branch kind must be one of: {allowed}")
+    branch_date = today or dt.date.today()
+    return f"{kind}/{branch_date:%Y_%m_%d}_{normalize_description(description)}"
+
+
+def parse_branch_name(branch: str) -> BranchName | None:
+    match = BRANCH_NAME_RE.fullmatch(branch)
+    if not match:
+        return None
+
+    try:
+        branch_date = dt.date(
+            int(match.group("year")),
+            int(match.group("month")),
+            int(match.group("day")),
+        )
+    except ValueError:
+        return None
+
+    return BranchName(
+        kind=match.group("kind"),
+        date=branch_date,
+        description=match.group("description"),
+    )
+
+
+def require_topic_branch(branch: str) -> BranchName:
+    if branch == MAIN_BRANCH:
+        raise FlowError(
+            "run this from a topic branch, not `main`; start with "
+            "`python scripts/pr_flow.py start feature your description`"
+        )
+
+    parsed = parse_branch_name(branch)
+    if parsed is None:
+        raise FlowError(
+            "branch name must match `feature/YYYY_MM_DD_description`, "
+            "`chore/YYYY_MM_DD_description`, or `fix/YYYY_MM_DD_description`"
+        )
+    return parsed
+
+
+def _run(command: Sequence[str]) -> None:
+    print(f"+ {shlex.join(command)}")
+    subprocess.run(list(command), check=True)
+
+
+def _output(command: Sequence[str]) -> str:
+    return subprocess.check_output(list(command), text=True).strip()
+
+
+def current_branch() -> str:
+    branch = _output(["git", "branch", "--show-current"])
+    if not branch:
+        raise FlowError("git is in a detached HEAD state")
+    return branch
+
+
+def ensure_clean_worktree() -> None:
+    status = _output(["git", "status", "--porcelain"])
+    if status:
+        raise FlowError("working tree has uncommitted changes; commit or stash them first")
+
+
+def ensure_matches_upstream(branch: str) -> None:
+    counts = _output(["git", "rev-list", "--left-right", "--count", "@{upstream}...HEAD"])
+    try:
+        behind_text, ahead_text = counts.split()
+        behind = int(behind_text)
+        ahead = int(ahead_text)
+    except ValueError as error:
+        raise FlowError(f"could not parse upstream status for `{branch}`: {counts}") from error
+
+    if ahead:
+        raise FlowError(
+            f"`{branch}` has local commits that are not on its upstream; "
+            "move them to a topic branch before starting new work"
+        )
+    if behind:
+        raise FlowError(f"`{branch}` is still behind its upstream after `git pull --ff-only`")
+
+
+def start_branch(
+    kind: str,
+    description_words: Sequence[str],
+    *,
+    today: dt.date | None = None,
+) -> str:
+    if current_branch() != MAIN_BRANCH:
+        raise FlowError("start must run from `main` so the topic branch begins there")
+
+    ensure_clean_worktree()
+    branch = build_branch_name(kind, " ".join(description_words), today=today)
+    _run(["git", "pull", "--ff-only"])
+    ensure_matches_upstream(MAIN_BRANCH)
+    _run(["git", "switch", "-c", branch])
+    return branch
+
+
+def create_pr(*, base_branch: str = MAIN_BRANCH, draft: bool = False) -> str:
+    branch = current_branch()
+    require_topic_branch(branch)
+    ensure_clean_worktree()
+
+    _run(["git", "push", "-u", "origin", branch])
+    _run(["git", "ls-remote", "--exit-code", "--heads", "origin", branch])
+
+    command = ["gh", "pr", "create", "--base", base_branch, "--head", branch, "--fill"]
+    if draft:
+        command.append("--draft")
+    _run(command)
+    return branch
+
+
+def _current_pr() -> dict[str, object]:
+    raw = _output(["gh", "pr", "view", "--json", "state,mergedAt,headRefName"])
+    try:
+        data = json.loads(raw)
+    except json.JSONDecodeError as error:
+        raise FlowError(f"could not parse `gh pr view` output: {error}") from error
+
+    if not isinstance(data, dict):
+        raise FlowError("`gh pr view` did not return a JSON object")
+    return data
+
+
+def finish_pr(*, base_branch: str = MAIN_BRANCH) -> str:
+    branch = current_branch()
+    require_topic_branch(branch)
+    ensure_clean_worktree()
+
+    pr = _current_pr()
+    if pr.get("headRefName") != branch:
+        raise FlowError("the current GitHub pull request does not match this branch")
+    if pr.get("state") != "MERGED" or not pr.get("mergedAt"):
+        raise FlowError("the pull request is not merged yet; merge it before running finish")
+
+    _run(["git", "switch", base_branch])
+    _run(["git", "pull", "--ff-only"])
+    return branch
+
+
+def build_parser() -> argparse.ArgumentParser:
+    parser = argparse.ArgumentParser(
+        description="Run this repository's contributor branch-and-PR workflow."
+    )
+    subparsers = parser.add_subparsers(dest="command", required=True)
+
+    start = subparsers.add_parser(
+        "start",
+        help="Create a required topic branch from main.",
+    )
+    start.add_argument("kind", choices=ALLOWED_BRANCH_KINDS)
+    start.add_argument("description", nargs="+")
+
+    create = subparsers.add_parser(
+        "create",
+        help="Push the current topic branch and open a pull request.",
+    )
+    create.add_argument("--base", default=MAIN_BRANCH)
+    create.add_argument("--draft", action="store_true")
+
+    finish = subparsers.add_parser(
+        "finish",
+        help="After the pull request is merged, switch back to main and sync.",
+    )
+    finish.add_argument("--base", default=MAIN_BRANCH)
+
+    return parser
+
+
+def main(argv: Sequence[str] | None = None) -> int:
+    parser = build_parser()
+    args = parser.parse_args(argv)
+
+    try:
+        if args.command == "start":
+            branch = start_branch(args.kind, args.description)
+            print(f"Created and switched to {branch}")
+        elif args.command == "create":
+            branch = create_pr(base_branch=args.base, draft=args.draft)
+            print(f"Pushed {branch} and opened a pull request")
+        elif args.command == "finish":
+            branch = finish_pr(base_branch=args.base)
+            print(f"Finished merged pull request for {branch}; back on {args.base}")
+        else:
+            parser.error(f"unknown command: {args.command}")
+    except FlowError as error:
+        print(f"error: {error}", file=sys.stderr)
+        return 2
+    except subprocess.CalledProcessError as error:
+        if isinstance(error.cmd, str):
+            command = error.cmd
+        else:
+            command = shlex.join(str(part) for part in error.cmd)
+        print(f"error: command failed: {command}", file=sys.stderr)
+        return error.returncode or 1
+
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
