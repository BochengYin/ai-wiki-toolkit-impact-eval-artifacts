+++ b/tests/test_pr_flow.py
@@ -0,0 +1,201 @@
+from __future__ import annotations
+
+import datetime as dt
+import importlib.util
+import json
+import sys
+from pathlib import Path
+
+import pytest
+
+
+ROOT = Path(__file__).resolve().parents[1]
+SPEC = importlib.util.spec_from_file_location("pr_flow", ROOT / "scripts" / "pr_flow.py")
+assert SPEC is not None
+assert SPEC.loader is not None
+pr_flow = importlib.util.module_from_spec(SPEC)
+sys.modules[SPEC.name] = pr_flow
+SPEC.loader.exec_module(pr_flow)
+
+
+def install_fake_commands(
+    monkeypatch: pytest.MonkeyPatch,
+    outputs: dict[tuple[str, ...], str],
+) -> list[list[str]]:
+    run_commands: list[list[str]] = []
+
+    def fake_output(command: list[str]) -> str:
+        key = tuple(command)
+        if key not in outputs:
+            raise AssertionError(f"unexpected output command: {command}")
+        return outputs[key]
+
+    def fake_run(command: list[str]) -> None:
+        run_commands.append(command)
+
+    monkeypatch.setattr(pr_flow, "_output", fake_output)
+    monkeypatch.setattr(pr_flow, "_run", fake_run)
+    return run_commands
+
+
+def test_build_branch_name_uses_required_prefix_date_and_slug() -> None:
+    branch = pr_flow.build_branch_name(
+        "feature",
+        "Add branch-and-PR helper!",
+        today=dt.date(2026, 4, 25),
+    )
+
+    assert branch == "feature/2026_04_25_add_branch_and_pr_helper"
+
+
+@pytest.mark.parametrize(
+    "branch",
+    [
+        "feat/2026_04_25_add_helper",
+        "feature/2026-04-25_add_helper",
+        "feature/2026_02_31_add_helper",
+        "docs/2026_04_25_add_helper",
+        "feature/2026_04_25_AddHelper",
+        "feature/2026_04_25_",
+    ],
+)
+def test_parse_branch_name_rejects_invalid_names(branch: str) -> None:
+    assert pr_flow.parse_branch_name(branch) is None
+
+
+def test_start_branch_creates_required_topic_branch_from_clean_main(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    commands = install_fake_commands(
+        monkeypatch,
+        {
+            ("git", "branch", "--show-current"): "main",
+            ("git", "status", "--porcelain"): "",
+            ("git", "rev-list", "--left-right", "--count", "@{upstream}...HEAD"): "0\t0",
+        },
+    )
+
+    branch = pr_flow.start_branch(
+        "fix",
+        ["release", "runtime", "check"],
+        today=dt.date(2026, 4, 25),
+    )
+
+    assert branch == "fix/2026_04_25_release_runtime_check"
+    assert commands == [
+        ["git", "pull", "--ff-only"],
+        ["git", "switch", "-c", "fix/2026_04_25_release_runtime_check"],
+    ]
+
+
+def test_start_branch_refuses_non_main_start(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    commands = install_fake_commands(
+        monkeypatch,
+        {("git", "branch", "--show-current"): "fix/2026_04_25_existing"},
+    )
+
+    with pytest.raises(pr_flow.FlowError, match="main"):
+        pr_flow.start_branch("fix", ["release"], today=dt.date(2026, 4, 25))
+
+    assert commands == []
+
+
+def test_start_branch_refuses_main_with_local_commits_after_pull(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    commands = install_fake_commands(
+        monkeypatch,
+        {
+            ("git", "branch", "--show-current"): "main",
+            ("git", "status", "--porcelain"): "",
+            ("git", "rev-list", "--left-right", "--count", "@{upstream}...HEAD"): "0\t1",
+        },
+    )
+
+    with pytest.raises(pr_flow.FlowError, match="local commits"):
+        pr_flow.start_branch("fix", ["release"], today=dt.date(2026, 4, 25))
+
+    assert commands == [["git", "pull", "--ff-only"]]
+
+
+def test_create_pr_pushes_current_topic_branch_and_opens_pr(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    branch = "feature/2026_04_25_add_pr_flow"
+    commands = install_fake_commands(
+        monkeypatch,
+        {
+            ("git", "branch", "--show-current"): branch,
+            ("git", "status", "--porcelain"): "",
+        },
+    )
+
+    assert pr_flow.create_pr() == branch
+    assert commands == [
+        ["git", "push", "-u", "origin", branch],
+        ["git", "ls-remote", "--exit-code", "--heads", "origin", branch],
+        ["gh", "pr", "create", "--base", "main", "--head", branch, "--fill"],
+    ]
+
+
+def test_create_pr_refuses_main(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    commands = install_fake_commands(
+        monkeypatch,
+        {("git", "branch", "--show-current"): "main"},
+    )
+
+    with pytest.raises(pr_flow.FlowError, match="topic branch"):
+        pr_flow.create_pr()
+
+    assert commands == []
+
+
+def test_finish_pr_requires_merged_pr_before_switching_to_main(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    branch = "fix/2026_04_25_release_runtime_check"
+    commands = install_fake_commands(
+        monkeypatch,
+        {
+            ("git", "branch", "--show-current"): branch,
+            ("git", "status", "--porcelain"): "",
+            ("gh", "pr", "view", "--json", "state,mergedAt,headRefName"): json.dumps(
+                {"state": "OPEN", "mergedAt": None, "headRefName": branch}
+            ),
+        },
+    )
+
+    with pytest.raises(pr_flow.FlowError, match="not merged"):
+        pr_flow.finish_pr()
+
+    assert commands == []
+
+
+def test_finish_pr_switches_to_main_after_merged_pr(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    branch = "chore/2026_04_25_update_docs"
+    commands = install_fake_commands(
+        monkeypatch,
+        {
+            ("git", "branch", "--show-current"): branch,
+            ("git", "status", "--porcelain"): "",
+            ("gh", "pr", "view", "--json", "state,mergedAt,headRefName"): json.dumps(
+                {
+                    "state": "MERGED",
+                    "mergedAt": "2026-04-25T00:00:00Z",
+                    "headRefName": branch,
+                }
+            ),
+        },
+    )
+
+    assert pr_flow.finish_pr() == branch
+    assert commands == [
+        ["git", "switch", "main"],
+        ["git", "pull", "--ff-only"],
+    ]
