+++ b/tests/test_pr_flow.py
@@ -0,0 +1,142 @@
+from __future__ import annotations
+
+import importlib.util
+import json
+from datetime import date
+from pathlib import Path
+from typing import Sequence
+
+
+ROOT = Path(__file__).resolve().parents[1]
+SPEC = importlib.util.spec_from_file_location("pr_flow", ROOT / "scripts" / "pr_flow.py")
+assert SPEC is not None
+assert SPEC.loader is not None
+pr_flow = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(pr_flow)
+
+
+class FakeRunner:
+    def __init__(self, outputs: dict[tuple[str, ...], str] | None = None) -> None:
+        self.outputs = outputs or {}
+        self.commands: list[tuple[str, ...]] = []
+
+    def run(self, args: Sequence[str], *, capture_stdout: bool = False) -> str:
+        command = tuple(args)
+        self.commands.append(command)
+        return self.outputs.get(command, "")
+
+
+def test_build_branch_name_normalizes_description_and_uses_required_shape() -> None:
+    branch_name = pr_flow.build_branch_name(
+        "feature",
+        "Add contributor PR flow!",
+        date(2026, 4, 25),
+    )
+
+    assert branch_name == "feature/2026_04_25_add_contributor_pr_flow"
+    assert pr_flow.branch_name_is_valid(branch_name)
+
+
+def test_branch_name_validation_rejects_wrong_kind_shape_and_bad_date() -> None:
+    assert not pr_flow.branch_name_is_valid("feat/2026_04_25_add_flow")
+    assert not pr_flow.branch_name_is_valid("feature/2026-04-25-add-flow")
+    assert not pr_flow.branch_name_is_valid("feature/2026_02_30_add_flow")
+
+
+def test_start_branch_requires_clean_worktree_and_creates_from_main() -> None:
+    runner = FakeRunner({("git", "status", "--porcelain"): ""})
+
+    branch_name = pr_flow.start_branch(
+        "fix",
+        "Release flow docs",
+        branch_date=date(2026, 4, 25),
+        runner=runner,
+    )
+
+    assert branch_name == "fix/2026_04_25_release_flow_docs"
+    assert runner.commands == [
+        ("git", "status", "--porcelain"),
+        ("git", "switch", "main"),
+        ("git", "pull", "--ff-only"),
+        ("git", "switch", "-c", "fix/2026_04_25_release_flow_docs"),
+    ]
+
+
+def test_create_pr_rejects_main_without_pushing() -> None:
+    runner = FakeRunner({("git", "branch", "--show-current"): "main"})
+
+    try:
+        pr_flow.create_pr(runner=runner, base="main", draft=False)
+    except pr_flow.FlowError as error:
+        assert "Do not open pull requests from main" in str(error)
+    else:
+        raise AssertionError("Expected create_pr to reject main")
+
+    assert runner.commands == [("git", "branch", "--show-current")]
+
+
+def test_create_pr_pushes_current_valid_branch_before_opening_pr() -> None:
+    branch_name = "chore/2026_04_25_update_contributor_flow"
+    runner = FakeRunner(
+        {
+            ("git", "branch", "--show-current"): branch_name,
+            ("git", "status", "--porcelain"): "",
+        }
+    )
+
+    result = pr_flow.create_pr(runner=runner, base="main", draft=True)
+
+    assert result == branch_name
+    assert runner.commands == [
+        ("git", "branch", "--show-current"),
+        ("git", "status", "--porcelain"),
+        ("git", "push", "-u", "origin", branch_name),
+        ("git", "ls-remote", "--exit-code", "--heads", "origin", branch_name),
+        ("gh", "pr", "create", "--base", "main", "--fill", "--draft"),
+    ]
+
+
+def test_finish_pr_requires_merged_pull_request_before_switching_to_main() -> None:
+    branch_name = "feature/2026_04_25_pr_helper"
+    runner = FakeRunner(
+        {
+            ("git", "branch", "--show-current"): branch_name,
+            ("gh", "pr", "view", branch_name, "--json", "state,mergedAt"): json.dumps(
+                {"state": "OPEN", "mergedAt": None}
+            ),
+        }
+    )
+
+    try:
+        pr_flow.finish_pr(runner=runner, base="main")
+    except pr_flow.FlowError as error:
+        assert "not merged yet" in str(error)
+    else:
+        raise AssertionError("Expected finish_pr to reject an unmerged PR")
+
+    assert runner.commands == [
+        ("git", "branch", "--show-current"),
+        ("gh", "pr", "view", branch_name, "--json", "state,mergedAt"),
+    ]
+
+
+def test_finish_pr_switches_to_main_after_pull_request_is_merged() -> None:
+    branch_name = "feature/2026_04_25_pr_helper"
+    runner = FakeRunner(
+        {
+            ("git", "branch", "--show-current"): branch_name,
+            ("gh", "pr", "view", branch_name, "--json", "state,mergedAt"): json.dumps(
+                {"state": "MERGED", "mergedAt": "2026-04-25T01:00:00Z"}
+            ),
+        }
+    )
+
+    result = pr_flow.finish_pr(runner=runner, base="main")
+
+    assert result == branch_name
+    assert runner.commands == [
+        ("git", "branch", "--show-current"),
+        ("gh", "pr", "view", branch_name, "--json", "state,mergedAt"),
+        ("git", "switch", "main"),
+        ("git", "pull", "--ff-only"),
+    ]
