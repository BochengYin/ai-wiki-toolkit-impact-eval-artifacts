diff --git a/src/ai_wiki_toolkit/contributor_workflow.py b/src/ai_wiki_toolkit/contributor_workflow.py
new file mode 100644
index 0000000..9b5d6b8
--- /dev/null
+++ b/src/ai_wiki_toolkit/contributor_workflow.py
@@ -0,0 +1,198 @@
+"""Contributor branch-and-PR workflow helpers."""
+
+from __future__ import annotations
+
+from collections.abc import Callable, Sequence
+from dataclasses import dataclass
+from datetime import date, datetime
+from pathlib import Path
+import re
+import subprocess
+
+from ai_wiki_toolkit.paths import resolve_repo_root
+
+CONTRIBUTOR_BRANCH_KINDS = ("feature", "chore", "fix")
+CONTRIBUTOR_BRANCH_PATTERN = (
+    r"^(?P<kind>feature|chore|fix)/"
+    r"(?P<branch_date>\d{4}_\d{2}_\d{2})_"
+    r"(?P<description>[a-z0-9]+(?:_[a-z0-9]+)*)$"
+)
+CONTRIBUTOR_BRANCH_RE = re.compile(CONTRIBUTOR_BRANCH_PATTERN)
+_DESCRIPTION_TOKEN_RE = re.compile(r"[^a-z0-9]+")
+
+GitRunner = Callable[[Path, Sequence[str]], str]
+
+
+class ContributorWorkflowError(RuntimeError):
+    """Raised when the contributor workflow cannot continue safely."""
+
+
+@dataclass(frozen=True)
+class ContributorWorkflowResult:
+    repo_root: Path
+    branch_name: str
+    ran_commands: tuple[tuple[str, ...], ...]
+
+
+def normalize_branch_description(description: str) -> str:
+    """Normalize free-form text to the required branch description suffix."""
+    normalized = _DESCRIPTION_TOKEN_RE.sub("_", description.strip().lower()).strip("_")
+    normalized = re.sub(r"_+", "_", normalized)
+    if not normalized:
+        raise ValueError("Branch description must contain at least one letter or number.")
+    return normalized
+
+
+def build_contributor_branch_name(
+    kind: str, description: str, today: date | None = None
+) -> str:
+    branch_kind = kind.strip()
+    if branch_kind not in CONTRIBUTOR_BRANCH_KINDS:
+        choices = ", ".join(CONTRIBUTOR_BRANCH_KINDS)
+        raise ValueError(f"Branch kind must be one of: {choices}.")
+
+    branch_date = today or date.today()
+    return (
+        f"{branch_kind}/"
+        f"{branch_date.strftime('%Y_%m_%d')}_"
+        f"{normalize_branch_description(description)}"
+    )
+
+
+def contributor_branch_name_error(branch_name: str) -> str | None:
+    match = CONTRIBUTOR_BRANCH_RE.match(branch_name)
+    if not match:
+        return (
+            "Contributor branch names must match "
+            "`feature/YYYY_MM_DD_description`, "
+            "`chore/YYYY_MM_DD_description`, or "
+            "`fix/YYYY_MM_DD_description`."
+        )
+
+    try:
+        datetime.strptime(match.group("branch_date"), "%Y_%m_%d")
+    except ValueError:
+        return "Contributor branch dates must be valid YYYY_MM_DD dates."
+
+    return None
+
+
+def validate_contributor_branch_name(branch_name: str) -> bool:
+    return contributor_branch_name_error(branch_name) is None
+
+
+def require_contributor_branch_name(branch_name: str) -> None:
+    error = contributor_branch_name_error(branch_name)
+    if error:
+        raise ContributorWorkflowError(error)
+
+
+def run_git(repo_root: Path, args: Sequence[str]) -> str:
+    try:
+        result = subprocess.run(
+            ["git", *args],
+            cwd=repo_root,
+            capture_output=True,
+            check=False,
+            text=True,
+        )
+    except OSError as exc:
+        raise ContributorWorkflowError(f"Could not run git: {exc}") from exc
+
+    if result.returncode != 0:
+        detail = result.stderr.strip() or result.stdout.strip()
+        command = "git " + " ".join(args)
+        if detail:
+            raise ContributorWorkflowError(f"`{command}` failed: {detail}")
+        raise ContributorWorkflowError(f"`{command}` failed.")
+
+    return result.stdout.strip()
+
+
+def current_branch(repo_root: Path, git_runner: GitRunner = run_git) -> str:
+    branch_name = git_runner(repo_root, ("branch", "--show-current")).strip()
+    if not branch_name:
+        raise ContributorWorkflowError("Could not determine the current git branch.")
+    return branch_name
+
+
+def start_contributor_branch(
+    kind: str,
+    description: str,
+    *,
+    repo_root: Path | None = None,
+    today: date | None = None,
+    pull: bool = True,
+    git_runner: GitRunner = run_git,
+) -> ContributorWorkflowResult:
+    root = repo_root or resolve_repo_root()
+    current = current_branch(root, git_runner=git_runner)
+    if current != "main":
+        raise ContributorWorkflowError(
+            "Contributor branches must start from `main`; "
+            f"current branch is `{current}`."
+        )
+
+    branch_name = build_contributor_branch_name(kind, description, today=today)
+    ran_commands: list[tuple[str, ...]] = []
+    if pull:
+        args = ("pull", "--ff-only")
+        git_runner(root, args)
+        ran_commands.append(args)
+
+    args = ("switch", "-c", branch_name)
+    git_runner(root, args)
+    ran_commands.append(args)
+    return ContributorWorkflowResult(
+        repo_root=root,
+        branch_name=branch_name,
+        ran_commands=tuple(ran_commands),
+    )
+
+
+def push_contributor_branch(
+    *,
+    repo_root: Path | None = None,
+    remote: str = "origin",
+    git_runner: GitRunner = run_git,
+) -> ContributorWorkflowResult:
+    root = repo_root or resolve_repo_root()
+    branch_name = current_branch(root, git_runner=git_runner)
+    if branch_name == "main":
+        raise ContributorWorkflowError(
+            "Do not push contributor changes from `main`; start a contributor branch first."
+        )
+    require_contributor_branch_name(branch_name)
+
+    args = ("push", "-u", remote, branch_name)
+    git_runner(root, args)
+    return ContributorWorkflowResult(
+        repo_root=root,
+        branch_name=branch_name,
+        ran_commands=(args,),
+    )
+
+
+def finish_contributor_branch(
+    *,
+    repo_root: Path | None = None,
+    pull: bool = True,
+    git_runner: GitRunner = run_git,
+) -> ContributorWorkflowResult:
+    root = repo_root or resolve_repo_root()
+    ran_commands: list[tuple[str, ...]] = []
+
+    args = ("switch", "main")
+    git_runner(root, args)
+    ran_commands.append(args)
+
+    if pull:
+        args = ("pull", "--ff-only")
+        git_runner(root, args)
+        ran_commands.append(args)
+
+    return ContributorWorkflowResult(
+        repo_root=root,
+        branch_name="main",
+        ran_commands=tuple(ran_commands),
+    )
