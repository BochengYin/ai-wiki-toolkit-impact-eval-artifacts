@@ -0,0 +1,26 @@
+from __future__ import annotations
+
+from typer.testing import CliRunner
+
+from ai_wiki_toolkit.cli import app
+
+runner = CliRunner()
+
+
+def test_contributor_branch_name_command_prints_valid_branch_name() -> None:
+    result = runner.invoke(
+        app,
+        [
+            "contributor",
+            "branch-name",
+            "feature",
+            "Add contributor PR helper",
+            "--date",
+            "2026_04_25",
+        ],
+    )
+
+    assert result.exit_code == 0
+    assert result.output.splitlines() == [
+        "feature/2026_04_25_add_contributor_pr_helper"
+    ]
diff --git a/tests/test_contributor_workflow.py b/tests/test_contributor_workflow.py
new file mode 100644
index 0000000..ba6b89c
--- /dev/null
+++ b/tests/test_contributor_workflow.py
@@ -0,0 +1,148 @@
+from __future__ import annotations
+
+from collections.abc import Sequence
+from datetime import date
+from pathlib import Path
+
+import pytest
+
+from ai_wiki_toolkit.contributor_workflow import (
+    ContributorWorkflowError,
+    build_contributor_branch_name,
+    contributor_branch_name_error,
+    finish_contributor_branch,
+    push_contributor_branch,
+    start_contributor_branch,
+    validate_contributor_branch_name,
+)
+
+
+FIXED_DATE = date(2026, 4, 25)
+
+
+def test_build_contributor_branch_name_normalizes_description() -> None:
+    branch_name = build_contributor_branch_name(
+        "feature",
+        "Add contributor PR helper",
+        today=FIXED_DATE,
+    )
+
+    assert branch_name == "feature/2026_04_25_add_contributor_pr_helper"
+
+
+@pytest.mark.parametrize("kind", ["feature", "chore", "fix"])
+def test_contributor_branch_name_allows_required_kinds(kind: str) -> None:
+    branch_name = f"{kind}/2026_04_25_update_docs"
+
+    assert validate_contributor_branch_name(branch_name) is True
+    assert contributor_branch_name_error(branch_name) is None
+
+
+@pytest.mark.parametrize(
+    "branch_name",
+    [
+        "main",
+        "docs/2026_04_25_update_docs",
+        "feature/2026-04-25_update_docs",
+        "feature/2026_04_25_update-docs",
+    ],
+)
+def test_contributor_branch_name_rejects_invalid_shapes(branch_name: str) -> None:
+    assert validate_contributor_branch_name(branch_name) is False
+    assert contributor_branch_name_error(branch_name) is not None
+
+
+def test_contributor_branch_name_rejects_invalid_dates() -> None:
+    assert (
+        contributor_branch_name_error("feature/2026_99_25_update_docs")
+        == "Contributor branch dates must be valid YYYY_MM_DD dates."
+    )
+
+
+def test_start_contributor_branch_requires_main(tmp_path: Path) -> None:
+    calls: list[tuple[str, ...]] = []
+
+    def fake_git_runner(repo_root: Path, args: Sequence[str]) -> str:
+        calls.append(tuple(args))
+        return "feature/2026_04_25_existing"
+
+    with pytest.raises(ContributorWorkflowError, match="must start from `main`"):
+        start_contributor_branch(
+            "feature",
+            "new helper",
+            repo_root=tmp_path,
+            today=FIXED_DATE,
+            git_runner=fake_git_runner,
+        )
+
+    assert calls == [("branch", "--show-current")]
+
+
+def test_start_contributor_branch_pulls_main_and_creates_new_branch(tmp_path: Path) -> None:
+    calls: list[tuple[str, ...]] = []
+
+    def fake_git_runner(repo_root: Path, args: Sequence[str]) -> str:
+        calls.append(tuple(args))
+        if tuple(args) == ("branch", "--show-current"):
+            return "main"
+        return ""
+
+    result = start_contributor_branch(
+        "feature",
+        "new helper",
+        repo_root=tmp_path,
+        today=FIXED_DATE,
+        git_runner=fake_git_runner,
+    )
+
+    assert result.branch_name == "feature/2026_04_25_new_helper"
+    assert result.ran_commands == (
+        ("pull", "--ff-only"),
+        ("switch", "-c", "feature/2026_04_25_new_helper"),
+    )
+    assert calls == [
+        ("branch", "--show-current"),
+        ("pull", "--ff-only"),
+        ("switch", "-c", "feature/2026_04_25_new_helper"),
+    ]
+
+
+def test_push_contributor_branch_rejects_main(tmp_path: Path) -> None:
+    def fake_git_runner(repo_root: Path, args: Sequence[str]) -> str:
+        return "main"
+
+    with pytest.raises(ContributorWorkflowError, match="Do not push"):
+        push_contributor_branch(repo_root=tmp_path, git_runner=fake_git_runner)
+
+
+def test_push_contributor_branch_pushes_current_valid_branch(tmp_path: Path) -> None:
+    calls: list[tuple[str, ...]] = []
+
+    def fake_git_runner(repo_root: Path, args: Sequence[str]) -> str:
+        calls.append(tuple(args))
+        if tuple(args) == ("branch", "--show-current"):
+            return "fix/2026_04_25_patch_release"
+        return ""
+
+    result = push_contributor_branch(repo_root=tmp_path, git_runner=fake_git_runner)
+
+    assert result.branch_name == "fix/2026_04_25_patch_release"
+    assert result.ran_commands == (("push", "-u", "origin", result.branch_name),)
+    assert calls == [
+        ("branch", "--show-current"),
+        ("push", "-u", "origin", "fix/2026_04_25_patch_release"),
+    ]
+
+
+def test_finish_contributor_branch_switches_back_to_main_and_pulls(tmp_path: Path) -> None:
+    calls: list[tuple[str, ...]] = []
+
+    def fake_git_runner(repo_root: Path, args: Sequence[str]) -> str:
+        calls.append(tuple(args))
+        return ""
+
+    result = finish_contributor_branch(repo_root=tmp_path, git_runner=fake_git_runner)
+
+    assert result.branch_name == "main"
+    assert result.ran_commands == (("switch", "main"), ("pull", "--ff-only"))
+    assert calls == [("switch", "main"), ("pull", "--ff-only")]
