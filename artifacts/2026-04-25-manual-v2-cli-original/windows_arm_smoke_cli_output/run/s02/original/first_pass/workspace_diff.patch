+---
+title: "Windows ARM smoke version checks must match CLI output"
+author_handle: "eval-user"
+model: "gpt-5"
+source_kind: "task"
+status: "draft"
+created_at: "2026-04-25T16:24:00+1000"
+updated_at: "2026-04-25T16:24:00+1000"
