diff --git a/tests/test_release_smoke_workflow.py b/tests/test_release_smoke_workflow.py
index 79b9a06..96139d8 100644
--- a/tests/test_release_smoke_workflow.py
+++ b/tests/test_release_smoke_workflow.py
@@ -28,3 +28,32 @@ def test_release_smoke_workflow_checks_release_archive_and_npm_install() -> None
     assert '& "release-assets/windows-arm64/aiwiki-toolkit.exe" --version' in workflow
     assert 'npm install -g "ai-wiki-toolkit@$version"' in workflow
     assert '& aiwiki-toolkit --version' in workflow
+
+
+def test_release_smoke_workflow_checks_full_cli_version_output() -> None:
+    workflow = (ROOT / ".github" / "workflows" / "release-smoke-windows-arm.yml").read_text(
+        encoding="utf-8"
+    )
+
+    assert (
+        workflow.count(
+            '$expectedVersion = "ai-wiki-toolkit ${{ steps.release.outputs.package_version }}"'
+        )
+        == 2
+    )
+    assert (
+        '$actualVersion = (& "release-assets/windows-arm64/aiwiki-toolkit.exe" --version).Trim()'
+        in workflow
+    )
+    assert '$actualVersion = (& aiwiki-toolkit --version).Trim()' in workflow
+    assert workflow.count("if ($actualVersion -ne $expectedVersion)") == 2
+    assert (
+        "throw \"Expected version '$expectedVersion' but binary returned '$actualVersion'.\""
+        in workflow
+    )
+    assert (
+        "throw \"Expected version '$expectedVersion' but npm-installed binary returned "
+        "'$actualVersion'.\""
+        in workflow
+    )
+    assert 'if ($version -ne "${{ steps.release.outputs.package_version }}")' not in workflow
